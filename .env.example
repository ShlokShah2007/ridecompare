# ==============================================================================
# RideCompare — Environment Variables Configuration
# ==============================================================================

# --- Application Configuration ---
PORT=3000
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Provider API Credentials (Optional: Dynamic Tariff Engine is active by default) ---

# Uber Rides API (https://developer.uber.com)
# Server token enables direct server-to-server estimate requests
UBER_CLIENT_ID=your_uber_client_id_here
UBER_CLIENT_SECRET=your_uber_client_secret_here
UBER_SERVER_TOKEN=your_uber_server_token_here

# Ola Cabs API (https://developers.olacabs.com)
# API key enables official Ola fare estimation
OLA_API_KEY=your_ola_api_key_here
OLA_CLIENT_ID=your_ola_client_id_here
OLA_CLIENT_SECRET=your_ola_client_secret_here

# Rapido Partner API (https://www.rapido.bike)
RAPIDO_API_KEY=your_rapido_api_key_here
RAPIDO_PARTNER_SECRET=your_rapido_secret_here

# Namma Yatri / Open Network Beckn Protocol (https://becknprotocol.io)
NAMMA_YATRI_API_KEY=your_beckn_gateway_key_here

# BluSmart Electric Mobility API (https://blu-smart.com)
BLUSMART_API_KEY=your_blusmart_api_key_here

# --- Maps & Routing Provider ---
# OpenStreetMap / OSRM is enabled by default with zero keys required.
# If you want to use Google Maps Geocoding and Directions API, specify:
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Custom OSRM Routing Endpoint (optional, defaults to public router.project-osrm.org)
OSRM_ROUTING_URL=https://router.project-osrm.org/route/v1/driving/
